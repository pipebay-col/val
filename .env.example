# ============================================================
# Val — configuración de instalación (v1.0)
# Copia este archivo a .env (o edita val-config.js directamente
# si sirves el HTML estático sin serverless).
# NUNCA subas tu .env real al repo (§10 del documento maestro).
# ============================================================

# ID del Google Sheet de la clínica (de la URL del Sheet)
SHEET_ID=COLOCA_TU_SHEET_ID

# WhatsApp de la clínica con indicativo de país (solo dígitos y +)
WHATSAPP=+573001234567

# Banco gratuito (§6): lo que se agote primero
FREE_QUOTA=100
FREE_QUOTA_MINUTOS=60

# URL de la página de planes (CTA al agotar el banco)
PLANES_URL=https://pipebay-col.github.io/val/planes
